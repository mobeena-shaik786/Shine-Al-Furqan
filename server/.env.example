PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/shine-al-furqan
MONGODB_URI=mongodb://127.0.0.1:27017/shine-al-furqan
# Required in all environments (min 32 characters). No secret fallbacks.
JWT_SECRET=change_me_jwt_secret_min_32_characters_long
# Access token TTL (DEFAULT: 15m). JWT_EXPIRES_IN is accepted as an alias.
JWT_ACCESS_EXPIRES_IN=15m
JWT_EXPIRES_IN=15m
# Refresh token cookie TTL (DEFAULT: 7d)
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false
# Set to true only for local demo bootstrapping on server start. Prefer: npm run seed
SEED_ON_START=false
# Local disk upload root (dev/demo). Production should use object storage — see docs/UPLOADS.md
UPLOAD_ROOT=./uploads
# Max upload size in bytes (DEFAULT 10 MiB)
UPLOAD_MAX_BYTES=10485760

# Mail (Phase 20) — console (default), smtp, or memory (tests)
MAIL_TRANSPORT=console
MAIL_FROM=Shine Al Furqan <noreply@shinealfurqan.local>
# Set MAIL_LOG_RESET_LINKS=false to hide reset URLs even in console mode
MAIL_LOG_RESET_LINKS=true
# SMTP (when MAIL_TRANSPORT=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Production checklist (see docs/DEPLOY.md) ---
# NODE_ENV=production
# CLIENT_URL=https://app.example.com
# COOKIE_SECURE=true
# SEED_ON_START=false
# MAIL_TRANSPORT=smtp
# SMTP_HOST=...
